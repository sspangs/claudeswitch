#!/usr/bin/env bash
# claudeswitch - manage Claude Code CLI logins, with per-repo auto-switching.
# Invoke as `claudeswitch` or the short alias `clsw`.
#
# Profiles:  ~/.config/claudeswitch/profiles/<name>.json   (mode 0600)
# Repo map:  ~/.config/claudeswitch/repos.json             (mode 0600)
# Default:   ~/.config/claudeswitch/default                (mode 0600)
# Active:    ~/.config/claudeswitch/active                 (mode 0600)
#
# Credential store (where Claude Code keeps auth material):
#   macOS:          Keychain, service "Claude Code-credentials"
#                   or config state for /login managed API keys
#   Linux/Windows:  ~/.claude/.credentials.json or config state

set -euo pipefail

PROG="$(basename "$0")"
SERVICE="Claude Code-credentials"
PROFILE_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/claudeswitch"
PROFILE_DIR="$PROFILE_ROOT/profiles"
MAP_FILE="$PROFILE_ROOT/repos.json"
DEFAULT_FILE="$PROFILE_ROOT/default"
ACTIVE_FILE="$PROFILE_ROOT/active"
LOCK_DIR="$PROFILE_ROOT/.lock"
# Claude Code keeps .claude.json at ~/.claude.json unless CLAUDE_CONFIG_DIR
# is explicitly set, in which case it lives inside that dir.
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  _default_claude_json="$CLAUDE_CONFIG_DIR/.claude.json"
else
  _default_claude_json="$HOME/.claude.json"
fi
CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CLAUDE_JSON="${CLAUDE_JSON:-$_default_claude_json}"
CREDS_FILE="$CLAUDE_CONFIG_DIR/.credentials.json"
SENTINEL_UNMANAGED="-"

detect_platform() {
  case "$(uname -s)" in
    Darwin)                 echo macos   ;;
    Linux)                  echo linux   ;;
    MINGW*|MSYS*|CYGWIN*)   echo windows ;;
    *)                      echo unknown ;;
  esac
}

PLATFORM="$(detect_platform)"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '[%s] %s\n' "$PROG" "$*" >&2; }

require() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

sha1_digest() {
  if command -v shasum >/dev/null 2>&1; then
    shasum
  elif command -v sha1sum >/dev/null 2>&1; then
    sha1sum
  else
    die "missing dependency: shasum or sha1sum"
  fi
}

mktemp_for() {
  # Temp file beside its destination: rename stays on one filesystem and
  # secret-bearing content never lands in a shared temp dir.
  mktemp "$(dirname "$1")/.tmp.XXXXXX"
}

detect_keychain_service() {
  local service
  service="$(security dump-keychain 2>/dev/null \
    | awk -F'"' '/"svce"<blob>="Claude Code-/{print $4; exit}' || true)"
  printf '%s\n' "${service:-$SERVICE}"
}

require jq
case "$PLATFORM" in
  macos)
    require security
    SERVICE="$(detect_keychain_service)"
    ;;
  linux|windows)      : ;;
  *)                  die "unsupported platform: $(uname -s)" ;;
esac

( umask 077; mkdir -p "$PROFILE_DIR" )
chmod 700 "$PROFILE_ROOT" "$PROFILE_DIR" 2>/dev/null || true

# --- locking ---------------------------------------------------------------

# Serialize everything that reads-then-writes the credential store, profile
# files, or repo map: concurrent `ensure` runs from parallel shells can
# otherwise interleave a snapshot with a switch and corrupt a profile.
# mkdir is the atomic primitive (macOS has no flock).
LOCK_HELD=""

lock_acquire() {
  [ -n "$LOCK_HELD" ] && return 0
  local tries=0 max_tries pid
  max_tries=$(( ${CLAUDESWITCH_LOCK_TIMEOUT:-10} * 10 ))
  until mkdir "$LOCK_DIR" 2>/dev/null; do
    pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      # Holder died without cleaning up; steal. (Tiny race with another
      # stealer here - acceptable for an interactive tool.)
      rm -rf -- "$LOCK_DIR"
      continue
    fi
    tries=$((tries+1))
    [ "$tries" -ge "$max_tries" ] \
      && die "timed out waiting for lock held by pid ${pid:-unknown} (if stale: rm -rf '$LOCK_DIR')"
    sleep 0.1
  done
  printf '%s' "$$" > "$LOCK_DIR/pid"
  LOCK_HELD=1
  trap lock_release EXIT
}

lock_release() {
  [ -n "$LOCK_HELD" ] || return 0
  rm -rf -- "$LOCK_DIR"
  LOCK_HELD=""
}

# --- credential store ------------------------------------------------------

creds_read_keychain_raw() {
  [ "$PLATFORM" = "macos" ] || return 1
  security find-generic-password -s "$SERVICE" -w 2>/dev/null
}

creds_read_keychain() {
  local raw
  raw="$(creds_read_keychain_raw)" || return 1
  if printf '%s' "$raw" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$raw"
  else
    CLSW_KEY="$raw" jq -cn '{primaryApiKey: env.CLSW_KEY}'
  fi
}

creds_keychain_store() {
  local raw
  raw="$(creds_read_keychain_raw)" || return 1
  if printf '%s' "$raw" | jq -e . >/dev/null 2>&1; then
    printf 'keychain\n'
  else
    printf 'keychain-api-key\n'
  fi
}

creds_read_file() {
  [ -f "$CREDS_FILE" ] || return 1
  cat "$CREDS_FILE"
}

creds_read_state_api_key() {
  [ -f "$CLAUDE_JSON" ] || return 1
  jq -cer 'select(.primaryApiKey? and .primaryApiKey != "")
    | {primaryApiKey: .primaryApiKey}' "$CLAUDE_JSON"
}

creds_read_with_store() {
  case "$PLATFORM" in
    macos)
      # Claude Code can have OAuth credentials and a /login managed API key at
      # the same time. That creates an auth conflict, so prefer the managed key
      # when present; `use` clears inactive auth to keep Claude Code sane.
      if creds_read_state_api_key >/dev/null 2>&1; then
        printf 'state-api-key\t%s\n' "$(creds_read_state_api_key)"
        return 0
      fi
      if creds_read_file >/dev/null 2>&1; then
        printf 'file\t%s\n' "$(creds_read_file)"
        return 0
      fi
      if creds_read_keychain >/dev/null 2>&1; then
        printf '%s\t%s\n' "$(creds_keychain_store)" "$(creds_read_keychain)"
        return 0
      fi
      return 1
      ;;
    linux|windows)
      if creds_read_state_api_key >/dev/null 2>&1; then
        printf 'state-api-key\t%s\n' "$(creds_read_state_api_key)"
        return 0
      fi
      if creds_read_file >/dev/null 2>&1; then
        printf 'file\t%s\n' "$(creds_read_file)"
        return 0
      fi
      return 1
      ;;
  esac
}

creds_read() {
  local line
  line="$(creds_read_with_store)" || return 1
  printf '%s' "${line#*$'\t'}"
}

creds_store() {
  local line
  line="$(creds_read_with_store)" || return 1
  printf '%s' "${line%%$'\t'*}"
}

creds_write_keychain() {
  local blob="$1" acct
  acct="$(security find-generic-password -s "$SERVICE" 2>/dev/null \
    | awk -F'"' '/"acct"<blob>=/{print $4; exit}' || true)"
  acct="${acct:-$USER}"
  security add-generic-password -s "$SERVICE" -a "$acct" -w "$blob" -U >/dev/null
}

creds_write_file() {
  local blob="$1"
  ( umask 077; mkdir -p "$CLAUDE_CONFIG_DIR" )
  chmod 700 "$CLAUDE_CONFIG_DIR" 2>/dev/null || true
  ( umask 077; printf '%s' "$blob" > "$CREDS_FILE" )
  chmod 600 "$CREDS_FILE" 2>/dev/null || true
}

creds_clear_keychain() {
  [ "$PLATFORM" = "macos" ] || return 0
  security delete-generic-password -s "$SERVICE" >/dev/null 2>&1 || true
}

creds_clear_file() {
  rm -f -- "$CREDS_FILE"
}

state_remove_api_key() {
  [ -f "$CLAUDE_JSON" ] || return 0
  local tmp
  tmp="$(mktemp_for "$CLAUDE_JSON")"
  jq 'del(.primaryApiKey)' "$CLAUDE_JSON" > "$tmp"
  mv "$tmp" "$CLAUDE_JSON"
  chmod 600 "$CLAUDE_JSON"
}

state_remove_oauth_identity() {
  [ -f "$CLAUDE_JSON" ] || return 0
  local tmp
  tmp="$(mktemp_for "$CLAUDE_JSON")"
  jq 'del(.oauthAccount, .userID)
    | .hasAvailableSubscription = false' "$CLAUDE_JSON" > "$tmp"
  mv "$tmp" "$CLAUDE_JSON"
  chmod 600 "$CLAUDE_JSON"
}

creds_write_state_api_key() {
  local blob="$1" tmp
  ( umask 077; mkdir -p "$CLAUDE_CONFIG_DIR" )
  chmod 700 "$CLAUDE_CONFIG_DIR" 2>/dev/null || true
  [ -f "$CLAUDE_JSON" ] || ( umask 077; printf '{}\n' > "$CLAUDE_JSON" )
  tmp="$(mktemp_for "$CLAUDE_JSON")"
  CLSW_BLOB="$blob" jq '.primaryApiKey = (env.CLSW_BLOB | fromjson | .primaryApiKey)' \
    "$CLAUDE_JSON" > "$tmp"
  mv "$tmp" "$CLAUDE_JSON"
  chmod 600 "$CLAUDE_JSON"
}

creds_write() {
  local blob="$1" store="${2:-}"
  case "$PLATFORM" in
    macos)
      case "$store" in
        state-api-key)
          creds_write_state_api_key "$blob"
          state_remove_oauth_identity
          creds_clear_keychain
          creds_clear_file
          ;;
        file)
          creds_write_file "$blob"
          state_remove_oauth_identity
          creds_clear_keychain
          ;;
        keychain-api-key)
          creds_write_keychain "$(printf '%s' "$blob" | jq -r '.primaryApiKey')"
          creds_clear_file
          state_remove_api_key
          ;;
        keychain|"")
          creds_write_keychain "$blob"
          creds_clear_file
          state_remove_api_key
          ;;
        *) die "unknown credential store: $store" ;;
      esac
      ;;
    linux|windows)
      case "$store" in
        state-api-key)
          creds_write_state_api_key "$blob"
          state_remove_oauth_identity
          creds_clear_file
          ;;
        file|"")
          creds_write_file "$blob"
          state_remove_api_key
          ;;
        *) die "unknown credential store: $store" ;;
      esac
      ;;
  esac
}

creds_missing_msg() {
  case "$PLATFORM" in
    macos)          echo "no active Claude Code login found in Keychain, $CREDS_FILE, or $CLAUDE_JSON - run 'claude' and sign in first" ;;
    linux|windows)  echo "no active Claude Code login in $CREDS_FILE or $CLAUDE_JSON - run 'claude' and sign in first" ;;
  esac
}

creds_location_label() {
  case "$PLATFORM" in
    macos)          echo "macOS Keychain, service \"$SERVICE\"; $CREDS_FILE; or $CLAUDE_JSON for /login managed API keys" ;;
    linux|windows)  echo "$CREDS_FILE or $CLAUDE_JSON for /login managed API keys" ;;
  esac
}

# --- profiles --------------------------------------------------------------

valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] \
    || die "invalid profile name: '$1' (use letters, digits, dot, dash, underscore)"
}

profile_path()  { printf '%s/%s.json' "$PROFILE_DIR" "$1"; }
profile_blob()  { jq -r '.blob'         "$1"; }
profile_email() { jq -r '.email // ""'  "$1"; }
profile_tier()  { jq -r '.tier  // "?"' "$1"; }
profile_store() { jq -r '.store // ""'  "$1"; }

blob_fingerprint() {
  # Empty output means "no fingerprint". Callers must never treat two
  # empty fingerprints as equal - hashing the empty extraction would make
  # a corrupt profile match any tokenless live blob.
  local key
  key="$(jq -r '.claudeAiOauth.refreshToken
    // .claudeAiOauth.accessToken
    // .primaryApiKey
    // empty' 2>/dev/null || true)"
  [ -n "$key" ] || return 0
  printf '%s' "$key" | sha1_digest | cut -c1-12
}

current_email_from_claude_json() {
  [ -f "$CLAUDE_JSON" ] || return 0
  jq -r '.oauthAccount.emailAddress // ""' "$CLAUDE_JSON" 2>/dev/null || true
}

# Capture the account-identity subtree of ~/.claude.json. Claude Code caches
# "who am I" here, so a credential swap alone isn't enough - we also have
# to splice these fields back on `use`. Keep this list minimal; add more
# only when a stale field causes a visible bug.
identity_from_claude_json() {
  [ -f "$CLAUDE_JSON" ] || { printf 'null'; return; }
  jq -c '{
    userID: .userID,
    oauthAccount: .oauthAccount,
    hasAvailableSubscription: .hasAvailableSubscription
  }' "$CLAUDE_JSON" 2>/dev/null || printf 'null'
}

splice_identity_into_claude_json() {
  local identity="$1" tmp
  [ -f "$CLAUDE_JSON" ] || return 0
  [ -n "$identity" ] && [ "$identity" != "null" ] || return 0
  tmp="$(mktemp_for "$CLAUDE_JSON")"
  jq --argjson id "$identity" '
    (if $id.userID then .userID = $id.userID else . end)
    | (if $id.oauthAccount then .oauthAccount = $id.oauthAccount else . end)
    | (if $id.hasAvailableSubscription != null
         then .hasAvailableSubscription = $id.hasAvailableSubscription
         else . end)
  ' "$CLAUDE_JSON" > "$tmp"
  mv "$tmp" "$CLAUDE_JSON"
  chmod 600 "$CLAUDE_JSON"
}

build_envelope() {
  local blob="$1" store="${2:-}" email tier saved_at identity
  email="$(current_email_from_claude_json)"
  tier="$(printf '%s' "$blob" | jq -r 'if .primaryApiKey then "api" else (.claudeAiOauth.subscriptionType // "?") end')"
  saved_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  identity="$(identity_from_claude_json)"
  [ -n "$store" ] || store="$(creds_store 2>/dev/null || true)"
  CLSW_BLOB="$blob" jq -n \
    --arg email "$email" \
    --arg tier "$tier" \
    --arg saved_at "$saved_at" \
    --arg store "$store" \
    --argjson identity "$identity" \
    '{blob: env.CLSW_BLOB, email: $email, tier: $tier, saved_at: $saved_at, store: $store, identity: $identity}'
}

list_profile_names() {
  shopt -s nullglob
  local f
  for f in "$PROFILE_DIR"/*.json; do
    basename "$f" .json
  done
}

# Last profile we activated (`use`) or captured (`save`).
get_active_record() {
  [ -f "$ACTIVE_FILE" ] || return 0
  local name
  name="$(tr -d '\n' < "$ACTIVE_FILE")"
  [ -n "$name" ] && [ -f "$(profile_path "$name")" ] && printf '%s\n' "$name"
  return 0
}

set_active_record()   { ( umask 077; printf '%s\n' "$1" > "$ACTIVE_FILE" ); }
clear_active_record() { rm -f "$ACTIVE_FILE"; }

active_profile_name() {
  local active active_fp name fp email recorded match="" ambiguous=""
  active="$(creds_read 2>/dev/null || true)"
  [ -n "$active" ] || return 0
  active_fp="$(printf '%s' "$active" | blob_fingerprint)"
  shopt -s nullglob
  for f in "$PROFILE_DIR"/*.json; do
    name="$(basename "$f" .json)"
    fp="$(profile_blob "$f" | blob_fingerprint)"
    if [ -n "$fp" ] && [ "$fp" = "$active_fp" ]; then
      echo "$name"
      return
    fi
  done

  # Fingerprint missed (refresh tokens rotate). Fall back to the cached
  # email and the active record; a wrong guess corrupts a profile on the
  # next snapshot, so on conflicting evidence return nothing.
  email="$(current_email_from_claude_json)"
  recorded="$(get_active_record)"

  if [ -n "$email" ]; then
    for f in "$PROFILE_DIR"/*.json; do
      if [ "$(profile_email "$f")" = "$email" ]; then
        if [ -n "$match" ]; then ambiguous=1; break; fi
        match="$(basename "$f" .json)"
      fi
    done
    if [ -n "$ambiguous" ]; then
      # Several profiles share this email; let the active record pick.
      if [ -n "$recorded" ] \
        && [ "$(profile_email "$(profile_path "$recorded")")" = "$email" ]; then
        echo "$recorded"
      fi
      return 0
    fi
    if [ -n "$match" ]; then
      if [ -n "$recorded" ] && [ "$recorded" != "$match" ]; then
        return 0
      fi
      echo "$match"
      return 0
    fi
    # Cached email matches no saved profile: an untracked login, so the
    # active record is stale too.
    return 0
  fi

  if [ -n "$recorded" ]; then
    # API keys never rotate, so a fingerprint miss rules an API-key
    # profile out; only OAuth tokens drift out of sync.
    if [ "$(profile_blob "$(profile_path "$recorded")" \
        | jq -r 'has("primaryApiKey")' 2>/dev/null)" != "true" ]; then
      echo "$recorded"
    fi
  fi
  return 0
}

# Capture the live blob (which Claude Code may have just refreshed) back
# into whichever profile it belongs to. Refresh tokens rotate on use, so
# without this the saved profile silently turns into a stale snapshot
# that the auth server will reject the next time we restore it.
snapshot_active_profile() {
  local name path live saved envelope tmp store
  lock_acquire
  name="$(active_profile_name)"
  [ -n "$name" ] || return 0
  path="$(profile_path "$name")"
  [ -f "$path" ] || return 0

  live="$(creds_read 2>/dev/null || true)"
  [ -n "$live" ] || return 0
  store="$(creds_store 2>/dev/null || true)"

  saved="$(profile_blob "$path")"
  [ "$saved" = "$live" ] && [ "$(profile_store "$path")" = "$store" ] && return 0

  envelope="$(build_envelope "$live" "$store")"
  tmp="$(mktemp_for "$path")"
  printf '%s\n' "$envelope" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$path"
  info "snapshotted refreshed credentials into profile: $name"
}

# --- repo map & default ----------------------------------------------------

get_mapping_exact() {
  local dir="$1"
  [ -f "$MAP_FILE" ] || return 0
  jq -r --arg k "$dir" 'if has($k) then .[$k] else "" end' "$MAP_FILE"
}

find_mapping() {
  # Walk upward from $1 until we find a mapping. Echo "<dir>|<value>" or nothing.
  local dir="$1" val
  while :; do
    val="$(get_mapping_exact "$dir")"
    if [ -n "$val" ]; then
      printf '%s|%s\n' "$dir" "$val"
      return
    fi
    [ "$dir" = "/" ] && return
    dir="$(dirname "$dir")"
  done
}

set_mapping() {
  local dir="$1" val="$2" tmp
  lock_acquire
  if [ ! -f "$MAP_FILE" ]; then
    ( umask 077; printf '{}\n' > "$MAP_FILE" )
  fi
  tmp="$(mktemp_for "$MAP_FILE")"
  jq --arg k "$dir" --arg v "$val" '.[$k] = $v' "$MAP_FILE" > "$tmp"
  mv "$tmp" "$MAP_FILE"
  chmod 600 "$MAP_FILE"
}

unset_mapping() {
  local dir="$1" tmp
  lock_acquire
  [ -f "$MAP_FILE" ] || return 0
  tmp="$(mktemp_for "$MAP_FILE")"
  jq --arg k "$dir" 'del(.[$k])' "$MAP_FILE" > "$tmp"
  mv "$tmp" "$MAP_FILE"
  chmod 600 "$MAP_FILE"
}

get_default() {
  [ -f "$DEFAULT_FILE" ] || return 0
  tr -d '\n' < "$DEFAULT_FILE"
}

set_default() {
  ( umask 077; printf '%s\n' "$1" > "$DEFAULT_FILE" )
}

clear_default() { rm -f "$DEFAULT_FILE"; }

abs_dir() {
  local d="${1:-$PWD}"
  if [ -d "$d" ]; then
    ( cd "$d" && pwd -P )
  else
    # Best-effort for paths that don't exist - normalize without resolving.
    python3 -c 'import os, sys; print(os.path.abspath(sys.argv[1]))' "$d" 2>/dev/null || echo "$d"
  fi
}

# --- internal: switch if needed -------------------------------------------

ensure_active() {
  local want="$1" cur
  [ -f "$(profile_path "$want")" ] || {
    info "warning: profile '$want' is missing; run '$PROG save $want' (or unlink)"
    return 0
  }
  lock_acquire
  cur="$(active_profile_name)"
  [ "$cur" = "$want" ] && return 0
  cmd_use "$want" >/dev/null
  info "switched to profile: $want"
}

# --- prompt flow (used by `ensure` and `link` w/o arg) ---------------------

prompt_pick_profile() {
  # Prints chosen profile name to stdout, or empty if cancelled.
  # $1 = label for the prompt header (e.g. "default profile").
  local label="$1"
  local names=() i=1 name email
  while IFS= read -r name; do names+=("$name"); done < <(list_profile_names)

  if [ ${#names[@]} -eq 0 ]; then
    echo "" >&2
    echo "no saved profiles yet. run '$PROG add <name>' first." >&2
    return 1
  fi

  echo "" >&2
  echo "pick a $label:" >&2
  for name in "${names[@]}"; do
    email="$(profile_email "$(profile_path "$name")")"
    if [ -n "$email" ]; then
      printf '  %d) %s  (%s)\n' "$i" "$name" "$email" >&2
    else
      printf '  %d) %s\n' "$i" "$name" >&2
    fi
    i=$((i+1))
  done

  local choice
  while :; do
    printf 'choose [1-%d, or q to cancel]: ' "${#names[@]}" >&2
    IFS= read -r choice </dev/tty || return 1
    if [ "$choice" = "q" ] || [ "$choice" = "Q" ]; then
      return 1
    fi
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#names[@]}" ]; then
      echo "${names[$((choice-1))]}"
      return 0
    fi
    echo "invalid choice." >&2
  done
}

resolve_claude_bin() {
  if [ -n "${CLAUDESWITCH_CLAUDE_BIN:-}" ]; then
    printf '%s\n' "$CLAUDESWITCH_CLAUDE_BIN"
    return 0
  fi

  local mise_npm_claude="$HOME/.local/share/mise/installs/npm-anthropic-ai-claude-code/latest/bin/claude"
  if [ -x "$mise_npm_claude" ]; then
    printf '%s\n' "$mise_npm_claude"
    return 0
  fi

  command -v claude
}

run_claude_bypassed() {
  local claude_bin
  claude_bin="$(resolve_claude_bin)" || die "missing dependency: claude"
  info "launching Claude Code: $claude_bin"
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    env CLAUDE_SWITCH_BYPASS=1 "$claude_bin" </dev/tty >/dev/tty 2>&1
  else
    env CLAUDE_SWITCH_BYPASS=1 "$claude_bin"
  fi
}

prompt_new_profile_flow() {
  # Prompt for a name, run login under bypass, save as that name.
  # Echoes the new profile name on success; returns 1 on cancel.
  local name
  while :; do
    printf 'name for the new profile (letters/digits/.-_): ' >&2
    IFS= read -r name </dev/tty || return 1
    [ -z "$name" ] && return 1
    if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "invalid name." >&2; continue
    fi
    if [ -e "$(profile_path "$name")" ]; then
      echo "profile '$name' already exists - pick another name." >&2; continue
    fi
    break
  done

  echo "" >&2
  echo "I'll launch Claude Code now (wrapper bypassed)." >&2
  echo "  1. In Claude Code, run:  /logout" >&2
  echo "  2. Then:                 /login  (sign in as the NEW account)" >&2
  echo "  3. Then quit Claude Code (Ctrl-C or /exit)" >&2
  printf 'press Enter to continue... ' >&2
  IFS= read -r _ </dev/tty || true

  snapshot_active_profile || true
  lock_release  # don't hold the lock across an interactive login
  run_claude_bypassed || true

  # Save whatever's now in the credential store as this profile.
  local blob
  blob="$(creds_read)" || { echo "no login was completed; aborting." >&2; return 1; }
  [ -n "$blob" ] || { echo "credential store is empty; aborting." >&2; return 1; }

  # Guard: don't collide with an existing profile's fingerprint.
  local new_fp cur_name
  new_fp="$(printf '%s' "$blob" | blob_fingerprint)"
  shopt -s nullglob
  for f in "$PROFILE_DIR"/*.json; do
    if [ -n "$new_fp" ] && [ "$(profile_blob "$f" | blob_fingerprint)" = "$new_fp" ]; then
      cur_name="$(basename "$f" .json)"
      echo "that looks like the same account as profile '$cur_name' - not saving a duplicate." >&2
      set_active_record "$cur_name"
      PROMPT_NEW_PROFILE_NAME="$cur_name"
      return 0
    fi
  done

  cmd_save "$name" >/dev/null
  PROMPT_NEW_PROFILE_NAME="$name"
}

prompt_and_resolve() {
  # Called by ensure when no mapping and no default.
  # On success: sets mapping/default, ensures active profile, returns 0.
  # On cancel: returns 1 (so wrapper aborts `claude`).
  local target="$1"
  local names=() name email i
  while IFS= read -r name; do names+=("$name"); done < <(list_profile_names)

  echo "" >&2
  echo "[$PROG] no Claude profile set for: $target" >&2
  echo "" >&2

  i=1
  for name in "${names[@]}"; do
    email="$(profile_email "$(profile_path "$name")")"
    if [ -n "$email" ]; then
      printf '  %d) use %s  (%s)\n' "$i" "$name" "$email" >&2
    else
      printf '  %d) use %s\n' "$i" "$name" >&2
    fi
    i=$((i+1))
  done
  local add_idx=$i
  printf '  %d) add a new profile (log in as another account)\n' "$add_idx" >&2
  local skip_idx=$((i+1))
  printf '  %d) do not manage this directory\n' "$skip_idx" >&2
  local default_idx=$((i+2))
  printf '  %d) set a default profile for all unmanaged dirs\n' "$default_idx" >&2

  local choice
  while :; do
    printf 'choose [1-%d, or q to cancel]: ' "$default_idx" >&2
    IFS= read -r choice </dev/tty || return 1
    if [ "$choice" = "q" ] || [ "$choice" = "Q" ]; then
      return 1
    fi
    [[ "$choice" =~ ^[0-9]+$ ]] || { echo "invalid choice." >&2; continue; }

    if [ "$choice" -ge 1 ] && [ "$choice" -lt "$add_idx" ]; then
      local picked="${names[$((choice-1))]}"
      set_mapping "$target" "$picked"
      info "linked $target -> $picked"
      ensure_active "$picked"
      return 0
    elif [ "$choice" -eq "$add_idx" ]; then
      local new_name
      prompt_new_profile_flow || return 1
      new_name="$PROMPT_NEW_PROFILE_NAME"
      set_mapping "$target" "$new_name"
      info "linked $target -> $new_name"
      ensure_active "$new_name"
      return 0
    elif [ "$choice" -eq "$skip_idx" ]; then
      set_mapping "$target" "$SENTINEL_UNMANAGED"
      info "marked $target as unmanaged"
      return 0
    elif [ "$choice" -eq "$default_idx" ]; then
      local picked
      picked="$(prompt_pick_profile "default profile")" || continue
      set_default "$picked"
      info "default profile set to: $picked"
      ensure_active "$picked"
      return 0
    else
      echo "invalid choice." >&2
    fi
  done
}

# --- commands --------------------------------------------------------------

cmd_save() {
  [ $# -eq 1 ] || die "usage: $PROG save <name>"
  valid_name "$1"
  local name="$1" path blob email envelope store
  path="$(profile_path "$name")"

  # Prompt before taking the lock so a lingering prompt can't block
  # other invocations.
  if [ -e "$path" ]; then
    printf "profile '%s' already exists - overwrite? [y/N] " "$name"
    IFS= read -r yn
    [[ "$yn" =~ ^[Yy]$ ]] || { echo "aborted"; exit 1; }
  fi

  lock_acquire
  blob="$(creds_read)" || die "$(creds_missing_msg)"
  [ -n "$blob" ] || die "credential store is empty"
  store="$(creds_store 2>/dev/null || true)"
  email="$(current_email_from_claude_json)"

  envelope="$(build_envelope "$blob" "$store")"
  ( umask 077; printf '%s\n' "$envelope" > "$path" )
  set_active_record "$name"
  printf 'saved profile: %s' "$name"
  [ -n "$email" ] && printf ' (%s)' "$email"
  printf '\n'
}

cmd_use() {
  [ $# -eq 1 ] || die "usage: $PROG use <name>"
  valid_name "$1"
  lock_acquire

  # Preserve any token Claude refreshed in the outgoing profile - otherwise
  # we'd overwrite the live (rotated) refresh token with the stale one we
  # snapshotted last time, and the auth server would reject it on next use.
  snapshot_active_profile

  local path blob identity store
  path="$(profile_path "$1")"
  [ -f "$path" ] || die "no such profile: $1"
  blob="$(profile_blob "$path")"
  [ -n "$blob" ] && [ "$blob" != "null" ] || die "profile '$1' is missing a blob (corrupt file?)"
  store="$(profile_store "$path")"

  creds_write "$blob" "$store"

  if [ "$store" != "state-api-key" ]; then
    identity="$(jq -c '.identity // null' "$path")"
    if [ "$identity" = "null" ]; then
      # No snapshot to splice; clear the outgoing identity so a stale email
      # can't misattribute the live credentials later.
      state_remove_oauth_identity
      info "profile '$1' has no identity snapshot - cleared stale identity from $CLAUDE_JSON."
      info "re-run '$PROG save $1' while signed in as that account to capture identity."
    else
      splice_identity_into_claude_json "$identity"
    fi
  fi

  set_active_record "$1"
  printf 'switched to profile: %s\n' "$1"
}

cmd_current() {
  local name path email tier blob live_email
  name="$(active_profile_name)"
  if [ -z "$name" ]; then
    blob="$(creds_read 2>/dev/null || true)"
    if [ -z "$blob" ]; then
      echo "no active login"
      return
    fi
    live_email="$(current_email_from_claude_json)"
    if [ -n "$live_email" ]; then
      printf '(unsaved - %s) - run %s save <name> to track it\n' "$live_email" "$PROG"
    else
      printf '(unsaved) - run %s save <name> to track it\n' "$PROG"
    fi
    return
  fi
  path="$(profile_path "$name")"
  email="$(profile_email "$path")"
  tier="$(profile_tier "$path")"
  printf '%s' "$name"
  [ -n "$email" ] && printf '  %s' "$email"
  [ -n "$tier" ] && [ "$tier" != "?" ] && printf '  [%s]' "$tier"
  printf '\n'
}

cmd_list() {
  local active_fp=""
  local active_name
  active_name="$(active_profile_name)"
  if [ -n "$active_name" ]; then
    active_fp="$(profile_blob "$(profile_path "$active_name")" | blob_fingerprint)"
  fi

  local default_name
  default_name="$(get_default)"

  shopt -s nullglob
  local files=("$PROFILE_DIR"/*.json)
  if [ ${#files[@]} -eq 0 ]; then
    echo "no saved profiles - run '$PROG add <name>' or '$PROG save <name>'"
    return
  fi

  printf '  %-2s %-20s %-32s %-8s %-8s\n' '' 'NAME' 'EMAIL' 'TIER' 'FLAGS'
  local f name email tier fp mark flags
  for f in "${files[@]}"; do
    name="$(basename "$f" .json)"
    email="$(profile_email "$f")"
    tier="$(profile_tier "$f")"
    fp="$(profile_blob "$f" | blob_fingerprint)"
    mark=' '
    [ -n "$active_fp" ] && [ "$fp" = "$active_fp" ] && mark='*'
    flags=''
    [ "$name" = "$default_name" ] && flags='default'
    printf '  %-2s %-20s %-32s %-8s %-8s\n' "$mark" "$name" "${email:--}" "$tier" "$flags"
  done
}

cmd_rm() {
  [ $# -eq 1 ] || die "usage: $PROG rm <name>"
  valid_name "$1"
  local path
  path="$(profile_path "$1")"
  [ -f "$path" ] || die "no such profile: $1"
  lock_acquire
  rm -f -- "$path"
  # Clean up references.
  if [ -f "$ACTIVE_FILE" ] && [ "$(tr -d '\n' < "$ACTIVE_FILE")" = "$1" ]; then
    clear_active_record
  fi
  if [ "$(get_default)" = "$1" ]; then
    clear_default
    info "cleared default (was $1)"
  fi
  if [ -f "$MAP_FILE" ]; then
    local tmp
    tmp="$(mktemp_for "$MAP_FILE")"
    jq --arg v "$1" 'with_entries(select(.value != $v))' "$MAP_FILE" > "$tmp"
    mv "$tmp" "$MAP_FILE"
    chmod 600 "$MAP_FILE"
  fi
  printf 'removed profile: %s\n' "$1"
}

cmd_link() {
  local target profile
  if [ $# -eq 0 ]; then
    target="$(abs_dir "$PWD")"
    profile="$(prompt_pick_profile "profile to link to $target")" || { echo "cancelled"; return 1; }
  elif [ $# -eq 1 ]; then
    target="$(abs_dir "$PWD")"
    profile="$1"
  elif [ $# -eq 2 ]; then
    target="$(abs_dir "$2")"
    profile="$1"
  else
    die "usage: $PROG link [<profile> [<dir>]]"
  fi
  valid_name "$profile"
  [ -f "$(profile_path "$profile")" ] || die "no such profile: $profile"
  set_mapping "$target" "$profile"
  printf 'linked %s -> %s\n' "$target" "$profile"

  # If we just linked the cwd, activate the profile now too. Otherwise the
  # link sits unused in repos.json until the shell wrapper next calls
  # `clsw ensure` before `claude` - which is a common gotcha when the
  # wrapper isn't installed.
  if [ "$target" = "$(abs_dir "$PWD")" ]; then
    ensure_active "$profile"
  fi
}

cmd_unlink() {
  local target
  target="$(abs_dir "${1:-$PWD}")"
  [ -f "$MAP_FILE" ] || { echo "no mappings."; return; }
  local cur
  cur="$(get_mapping_exact "$target")"
  if [ -z "$cur" ]; then
    echo "no mapping for: $target"
    return
  fi
  unset_mapping "$target"
  printf 'unlinked %s (was %s)\n' "$target" "$cur"
}

cmd_which() {
  local target
  target="$(abs_dir "${1:-$PWD}")"
  local hit dir val default_name
  hit="$(find_mapping "$target")"
  default_name="$(get_default)"

  if [ -n "$hit" ]; then
    dir="${hit%%|*}"
    val="${hit#*|}"
    if [ "$val" = "$SENTINEL_UNMANAGED" ]; then
      printf '(unmanaged - mapped at %s)\n' "$dir"
    else
      if [ "$dir" = "$target" ]; then
        printf '%s (linked)\n' "$val"
      else
        printf '%s (inherited from %s)\n' "$val" "$dir"
      fi
    fi
    return
  fi
  if [ -n "$default_name" ]; then
    printf '%s (default)\n' "$default_name"
    return
  fi
  echo "(no mapping, no default - would prompt on next 'claude')"
}

cmd_default() {
  if [ $# -eq 0 ]; then
    local d
    d="$(get_default)"
    if [ -n "$d" ]; then echo "$d"; else echo "(no default set)"; fi
    return
  fi
  if [ "$1" = "--clear" ]; then
    clear_default
    echo "default cleared"
    return
  fi
  valid_name "$1"
  [ -f "$(profile_path "$1")" ] || die "no such profile: $1"
  set_default "$1"
  printf 'default profile set to: %s\n' "$1"
}

cmd_add() {
  [ $# -eq 1 ] || die "usage: $PROG add <name>"
  valid_name "$1"
  local name="$1"
  [ -e "$(profile_path "$name")" ] && die "profile '$name' already exists"

  echo "I'll launch Claude Code now (wrapper bypassed)."
  echo "  1. /logout"
  echo "  2. /login as the NEW account"
  echo "  3. quit Claude Code"
  printf 'press Enter to continue... '
  IFS= read -r _ </dev/tty || true

  snapshot_active_profile || true
  lock_release  # don't hold the lock across an interactive login
  run_claude_bypassed || true

  local blob
  blob="$(creds_read)" || die "no login was completed"
  [ -n "$blob" ] || die "credential store is empty"
  cmd_save "$name"
}

cmd_ensure() {
  local target
  target="$(abs_dir "${1:-$PWD}")"

  local hit
  hit="$(find_mapping "$target")"
  if [ -n "$hit" ]; then
    local val="${hit#*|}"
    if [ "$val" = "$SENTINEL_UNMANAGED" ]; then
      return 0
    fi
    if [ ! -f "$(profile_path "$val")" ]; then
      info "mapping points to missing profile '$val'; falling through"
    else
      ensure_active "$val"
      return 0
    fi
  fi

  local default_name
  default_name="$(get_default)"
  if [ -n "$default_name" ] && [ -f "$(profile_path "$default_name")" ]; then
    ensure_active "$default_name"
    return 0
  fi

  prompt_and_resolve "$target"
}

cmd_init_shell() {
  local shell="${1:-}"
  case "$shell" in
    fish)
      cat <<'EOF'
function claude --description 'claude with claudeswitch per-repo auto-switching'
    if set -q CLAUDE_SWITCH_BYPASS
        command claude $argv
        return
    end
    if command -q claudeswitch
        if not claudeswitch ensure
            return 1
        end
    end
    command claude $argv
end
EOF
      ;;
    bash|zsh)
      cat <<'EOF'
claude() {
  if [ -n "${CLAUDE_SWITCH_BYPASS:-}" ]; then
    command claude "$@"
    return
  fi
  if command -v claudeswitch >/dev/null 2>&1; then
    claudeswitch ensure || return 1
  fi
  command claude "$@"
}
EOF
      ;;
    *)
      die "usage: $PROG init-shell <fish|bash|zsh>"
      ;;
  esac
}

cmd_paths() {
  printf 'profiles: %s\n' "$PROFILE_DIR"
  printf 'repo map: %s\n' "$MAP_FILE"
  printf 'default:  %s\n' "$DEFAULT_FILE"
  printf 'active:   %s\n' "$ACTIVE_FILE"
  printf 'creds:    %s\n' "$(creds_location_label)"
}

cmd_help() {
  cat <<EOF
$PROG - manage Claude Code CLI logins (alias: clsw)

profile management:
  $PROG save <name>            snapshot the current login as <name>
  $PROG add  <name>            log in as a new account, then save it as <name>
  $PROG use  <name>            make <name> the active login
  $PROG list                   list saved profiles (marks active with *)
  $PROG current                print the active profile
  $PROG paths                  show where claudeswitch keeps state
  $PROG rm <name>              delete a saved profile

per-directory auto-switching:
  $PROG link [<profile> [dir]] link current (or given) dir to a profile
  $PROG unlink [<dir>]         remove mapping for current (or given) dir
  $PROG which [<dir>]          show the effective profile for a dir
  $PROG default [<name>]       show / set the fallback profile
  $PROG default --clear        clear the fallback profile
  $PROG ensure                 internal: used by the shell wrapper
  $PROG init-shell <fish|bash|zsh>
                               print a 'claude' shell wrapper to eval

the wrapper will prompt the first time you run \`claude\` in an
unmanaged directory. set \$CLAUDE_SWITCH_BYPASS=1 to skip the wrapper.
existing \`claude\` sessions must be restarted to pick up a switch.
EOF
}

# --- dispatch --------------------------------------------------------------

cmd="${1:-help}"
shift || true
case "$cmd" in
  save)               cmd_save       "$@" ;;
  add)                cmd_add        "$@" ;;
  use|switch)         cmd_use        "$@" ;;
  list|ls)            cmd_list       "$@" ;;
  current|who)        cmd_current    "$@" ;;
  paths)              cmd_paths      "$@" ;;
  rm|remove|delete)   cmd_rm         "$@" ;;
  link)               cmd_link       "$@" ;;
  unlink)             cmd_unlink     "$@" ;;
  which)              cmd_which      "$@" ;;
  default)            cmd_default    "$@" ;;
  ensure)             cmd_ensure     "$@" ;;
  init-shell)         cmd_init_shell "$@" ;;
  help|-h|--help)     cmd_help            ;;
  *) die "unknown command: '$cmd' (try '$PROG help')" ;;
esac
